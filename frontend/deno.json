{
    "tasks": {
        "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys --allow-ffi --allow-run npm:vite",
        "build": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-ffi --allow-run npm:vite build",
        "preview": "deno run --allow-net --allow-read --allow-env --allow-sys --allow-ffi --allow-run npm:vite preview",
        "test": "deno run -A npm:vitest",
        "test:run": "deno run -A npm:vitest run",
        "test:coverage": "deno run -A npm:vitest run --coverage",
        "test:e2e": "deno run -A npm:@playwright/test test --project=chromium",
        "test:e2e:all": "deno run -A npm:@playwright/test test",
        "test:e2e:install": "deno run -A npm:playwright install --with-deps"
    },
    "imports": {
        "react": "npm:react@18.2.0",
        "react-dom": "npm:react-dom@18.2.0",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@4.2.0",
        "vite": "npm:vite@5.0.0",
        "typescript": "npm:typescript@5.3.3",
        "vitest": "npm:vitest@2.1.9",
        "@vitest/coverage-v8": "npm:@vitest/coverage-v8@2.1.9",
        "happy-dom": "npm:happy-dom@15.11.7",
        "@testing-library/react": "npm:@testing-library/react@16.1.0",
        "@testing-library/jest-dom": "npm:@testing-library/jest-dom@6.6.3",
        "@testing-library/user-event": "npm:@testing-library/user-event@14.5.2",
        "msw": "npm:msw@2.7.0",
        "@playwright/test": "npm:@playwright/test@1.49.1"
    },
    "nodeModulesDir": "auto"
}
