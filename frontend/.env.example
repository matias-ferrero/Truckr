# Frontend environment template — copy to `.env.local` (gitignored) for local dev.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Backend API base URL. The Vite dev server proxies under /api by default if unset.
VITE_API_BASE_URL=http://localhost:3000

# Google Maps JavaScript API key (Places library). Required for the AddressPicker
# (US48 / REQ-FE-00025). If absent, the picker degrades to a service-unavailable
# fallback and the rest of the form stays usable.
VITE_GOOGLE_MAPS_API_KEY=
