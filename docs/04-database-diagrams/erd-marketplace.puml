@startuml erd-marketplace
title Entity Relationships — Marketplace (Draft v1)

entity "transport_windows" as tw {
  * id : bigint <<PK>>
  --
  * carrier_id : bigint <<FK>>
  * vehicle_id : bigint <<FK>>
  * origin_city : string
  origin_lat : decimal(9,6)
  origin_lng : decimal(9,6)
  * destination_city : string
  destination_lat : decimal(9,6)
  destination_lng : decimal(9,6)
  * start_at : datetime
  * end_at : datetime
  available_capacity_kg : integer
  price_reference : decimal
  status : string [open, matched, expired, cancelled]
  * created_at : datetime
  * updated_at : datetime
}

entity "cargo_offers" as co {
  * id : bigint <<PK>>
  --
  * shipper_id : bigint <<FK>>
  * origin_city : string
  origin_lat : decimal(9,6)
  origin_lng : decimal(9,6)
  * destination_city : string
  destination_lat : decimal(9,6)
  destination_lng : decimal(9,6)
  * pickup_at : datetime
  * weight_kg : integer
  goods_description : text
  special_handling : string
  max_price : decimal
  status : string [open, quoted, accepted, cancelled]
  * created_at : datetime
  * updated_at : datetime
}

entity "quotes" as q {
  * id : bigint <<PK>>
  --
  * cargo_offer_id : bigint <<FK>>
  transport_window_id : bigint <<FK>>
  * carrier_id : bigint <<FK>>
  * vehicle_id : bigint <<FK>>
  * price_cents : integer
  * currency : string = 'ARS'
  message : text
  status : string [pending, accepted, rejected, expired]
  accepted_at : datetime
  expires_at : datetime
  * created_at : datetime
  * updated_at : datetime
}

tw }o--o{ q : "referenced by (optional)"
co ||--o{ q : "receives"

note bottom
  Lat / lng stored as DECIMAL(9,6) columns (ADR-010); no spatial index
  Phase 0/1. PKs are bigint (ADR-007). Currency stored as ISO 4217 string,
  default 'ARS'. Hard-deleted (ADR-009).

  Cross-context FK: quotes.vehicle_id → vehicles.id (Identity). The Carrier
  commits a specific Vehicle when quoting; if transport_window_id is set,
  quotes.vehicle_id MUST equal transport_windows.vehicle_id. The vehicle is
  copied into shipments.vehicle_id at acceptance (Fulfilment § 4.1) and
  frozen there. See erd-overview.puml for the cross-context wiring.
end note

@enduml
