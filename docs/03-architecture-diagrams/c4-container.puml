@startuml c4-container
!include <C4/C4_Container>

title Container Diagram — Truckr®

Person(transportista, "Transportista")
Person(expedidor, "Expedidor")

System_Boundary(truckr, "Truckr® Platform") {
  Container(spa, "Frontend SPA", "React 18 + TypeScript + Vite", "Static bundle served to browsers. Renders the landing page from local landingContent.ts (no backend call today). Will host marketplace UI and call the API.")

  Container(api, "Backend API", "Rails 8.1 (API-only) + Puma + Thruster", "Hosts ActiveAdmin and /up health check today; will own domain, business logic, and HTTP boundary. Exposes JSON under /api/* once domain endpoints land.")

  ContainerDb(primary_db, "Primary database", "SQLite", "Domain tables (users, transport_windows, shipments, ...). Currently empty — only ActiveAdmin/Devise tables exist.")
  ContainerDb(cache_db, "Cache database", "SQLite (Solid Cache)", "DB-backed Rails.cache.")
  ContainerDb(queue_db, "Queue database", "SQLite (Solid Queue)", "DB-backed Active Job queue.")
  ContainerDb(cable_db, "Cable database", "SQLite (Solid Cable)", "DB-backed Action Cable pub/sub.")

  Container(worker, "Background worker", "solid_queue", "Runs Active Job tasks: tracking ingestion, invoice emission, notifications. Not yet populated.")

  Container(docs, "Academic documentation", "Typst + just + Python", "Builds artifacts.pdf and prompts.pdf. Attached to GitHub releases by release-please.")
}

System_Ext(payments, "Payment gateway")
System_Ext(insurance, "Insurance provider")
System_Ext(arca, "ARCA")
System_Ext(maps, "Maps / GPS provider")

Rel(transportista, spa, "Uses", "HTTPS")
Rel(expedidor, spa, "Uses", "HTTPS")

Rel(spa, api, "Will call JSON endpoints (no calls today)", "HTTPS / JSON")

Rel(api, primary_db, "Reads / writes", "Active Record")
Rel(api, cache_db, "Reads / writes", "Rails.cache")
Rel(api, queue_db, "Enqueues jobs", "Active Job")
Rel(worker, queue_db, "Polls and runs jobs", "Active Job")
Rel(api, cable_db, "Publishes broadcasts", "Action Cable")

Rel(api, payments, "HTTPS", "(planned)")
Rel(api, insurance, "HTTPS", "(planned)")
Rel(api, arca, "HTTPS", "(planned)")
Rel(api, maps, "HTTPS", "(planned)")

SHOW_LEGEND()
@enduml
