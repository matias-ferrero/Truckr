# Secrets are FETCHED at deploy time — never stored in plaintext in this file.
# Safe to commit because the lines below are shell recipes, not values.
#
# This file is parsed by Kamal as dotenv, NOT bash. That means $VAR and
# $(command) substitutions work, but ${VAR:-default} bash defaults do not.
# TRUCKR_ENV and AWS_REGION must be set by the caller — pass-through only.
#
# Operator prerequisites (laptop deploy):
#   1. Export TRUCKR_ENV (staging or production) and AWS_REGION (sa-east-1).
#   2. AWS CLI configured with credentials that allow:
#        - ssm:GetParameter on  /truckr/${TRUCKR_ENV}/*
#        - kms:Decrypt          on the SSM-managed KMS key
#        - ecr:GetAuthorizationToken
#   3. session-manager-plugin installed if `KAMAL_SSH_PROXY_COMMAND` is set
#      (CI sets it; laptop default leaves it empty for direct SSH).

TRUCKR_ENV=$TRUCKR_ENV
AWS_REGION=$AWS_REGION

KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region "$AWS_REGION")
RAILS_MASTER_KEY=$(aws ssm get-parameter --name "/truckr/${TRUCKR_ENV}/rails_master_key" --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")

# Google Maps API key, shared with the SPA bundle (same SSM param the
# frontend deploy reads as VITE_GOOGLE_MAPS_API_KEY). Plain String, not
# SecureString — no --with-decryption — the key is public-by-design and
# constrained by referrer/API restrictions in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=$(aws ssm get-parameter --name "/truckr/${TRUCKR_ENV}/google_maps_api_key" --query Parameter.Value --output text --region "$AWS_REGION")

# Seed admin credentials are optional — only consumed when `rails db:seed`
# is invoked. Production hasn't created them; tolerate the param missing in
# any env that hasn't bootstrapped a seed admin yet.
SEED_ADMIN_EMAIL=$(aws ssm get-parameter --name "/truckr/${TRUCKR_ENV}/seed_admin_email" --with-decryption --query Parameter.Value --output text --region "$AWS_REGION" 2>/dev/null || echo "")
SEED_ADMIN_PASSWORD=$(aws ssm get-parameter --name "/truckr/${TRUCKR_ENV}/seed_admin_password" --with-decryption --query Parameter.Value --output text --region "$AWS_REGION" 2>/dev/null || echo "")
