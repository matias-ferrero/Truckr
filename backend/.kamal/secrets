# Secrets are FETCHED at deploy time — never stored in plaintext in this file.
# Safe to commit because the lines below are shell recipes, not values.
#
# Operator prerequisites:
#   1. AWS CLI configured with credentials that allow:
#        - ssm:GetParameter on  /truckr/${env}/*
#        - kms:Decrypt          on the SSM-managed KMS key
#        - ecr:GetAuthorizationToken
#   2. AWS_REGION env var set to the staging region (e.g. export AWS_REGION=sa-east-1)

AWS_REGION=$AWS_REGION
KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region "$AWS_REGION")
RAILS_MASTER_KEY=$(aws ssm get-parameter --name /truckr/staging/rails_master_key --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")
SEED_ADMIN_EMAIL=$(aws ssm get-parameter --name /truckr/staging/seed_admin_email --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")
SEED_ADMIN_PASSWORD=$(aws ssm get-parameter --name /truckr/staging/seed_admin_password --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")
