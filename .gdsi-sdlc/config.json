  "automation": {
    "enabled": false,
    "cooldowns": {
      "plan_minutes": 60,
      "implement_minutes": 120,
      "troubleshoot_minutes": 30,
      "review_minutes": 60
    },
    "max_concurrent": 3
  },
  "status_mapping": {
    "Backlog": "Backlog",
    "Ready": "Ready",
    "In progress": "InProgress",
    "In review": "InReview",
    "Done": "Done"
  },
  "folder_to_status": {
    "Backlog": "Backlog",
    "Ready": "Ready",
    "InProgress": "In progress",
    "InReview": "In review",
    "Done": "Done"
  },
  "documentation": {
    "docs_path": "docs",
    "tech_docs": true,
    "oe_assessment": false,
    "onboarding": false,
    "last_generated": "2026-04-17"
  }
